# Free key from https://console.groq.com/keys (needed only for the AI Analyst tab)
GROQ_API_KEY=your_api_key_here
# Optional: any chat model your key can use (see https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b
# Optional: AI question limits (per visitor session, and per day across all visitors)
# AI_SESSION_LIMIT=10
# AI_DAILY_LIMIT=200
