# Copy to .streamlit/secrets.toml for local use, or paste these lines into
# the app's Settings > Secrets on Streamlit Community Cloud.
# Only needed for the AI Analyst tab; the rest of the dashboard works without it.

GROQ_API_KEY = "your_api_key_here"   # free key: https://console.groq.com/keys

# Optional
# GROQ_MODEL = "openai/gpt-oss-120b"
# AI_SESSION_LIMIT = 10    # questions per visitor session
# AI_DAILY_LIMIT = 200     # questions per day, shared by all visitors
